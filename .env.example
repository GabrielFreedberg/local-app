APP_BASE_URL="http://127.0.0.1:8000"

# Supabase hosted auth + database
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_DB_URL="postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres"

# Email delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your-email@example.com"
SMTP_PASSWORD="your-email-app-password"
EMAIL_FROM="your-email@example.com"

# Optional: AI-assisted category matching (see README "AI-assisted matching").
# Without this set, matching is keyword-only (word-boundary match on deal
# title/description/store name) — the app works completely fine either way.
ANTHROPIC_API_KEY="your-anthropic-api-key"
AI_CATEGORY_MODEL="claude-3-5-haiku-latest"
